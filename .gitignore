# Generated devkitPro build products.
/output/
/build/
/deploy/
/*.elf
/*.nso
/*.npdm
/*.map

# Locally generated SD/release staging.
/atmosphere/
/dist/
/release/

# Local development documentation; public build instructions live in README.md.
/docs/

# Development-only GDB diagnostics; public builds do not require these scripts.
/tools/switch_gdb/

# Python/GDB caches.
__pycache__/
*.pyc

# Local SD/FTP configuration should be reviewed before publication.
*.local.mk
